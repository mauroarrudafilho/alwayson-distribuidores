# Copie para .env e preencha a chave em:
# Supabase → Project Settings → API → anon public
# Project ref (dashboard / MCP): osukbalwykbqvoumddxz

VITE_SUPABASE_URL=https://osukbalwykbqvoumddxz.supabase.co
VITE_SUPABASE_ANON_KEY=

# API de ingestão de relatórios (POST /api/ingest). Local: npm run ingest:api
VITE_INGEST_API_URL=http://localhost:8787

# ── Recebimento automático (Pacote G, Canal 1 — CloudMailin → Edge Function) ──
# API de ingestão (Railway): INGEST_INTERNAL_SECRET é o segredo que o Edge
# Function `ingest-inbound-cloudmailin` apresenta no header
# x-ingest-internal-secret ao chamar POST /api/ingest. Gere um valor único e
# configure nos DOIS lugares: env do serviço alwayson-ingest-api (Railway) e
# secret da Edge Function no Supabase.
# INGEST_INTERNAL_SECRET=

# Edge Function `ingest-inbound-cloudmailin` (webhook do e-mail inbound).
# Deploy com: supabase functions deploy ingest-inbound-cloudmailin --no-verify-jwt
# Secrets da função:
#   INGEST_API_URL          ex.: https://alwayson-ingest-api-production.up.railway.app
#   INGEST_INTERNAL_SECRET  mesmo valor do env da API de ingestão acima
#   CLOUDMAILIN_USER        usuário do Basic Auth da URL-alvo do CloudMailin
#   CLOUDMAILIN_PASS        senha do Basic Auth da URL-alvo do CloudMailin
# URL-alvo do webhook no CloudMailin:
#   https://{CLOUDMAILIN_USER}:{CLOUDMAILIN_PASS}@osukbalwykbqvoumddxz.functions.supabase.co/ingest-inbound-cloudmailin
# O bucket de storage `ingest-inbox` guarda o anexo bruto (auditoria/reprocesso).

# URL pública da app (convites, redirects Auth). Em produção na Vercel:
# VITE_APP_URL=https://alwayson-distribuidores.vercel.app

# Pipeline PDV / Explorar (Railway). Local: npm run pdv:api — ver docs/PDV_PIPELINE_RAILWAY.md
# PDV_PIPELINE_SECRET=gerar-segredo-longo
# RECEITA_DATA_DIR=./data/receita

# Scripts locais (insights:import) + API de ingestão — nunca expor no frontend. Use a service_role do mesmo projeto.
# SUPABASE_URL=https://osukbalwykbqvoumddxz.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Edge Function `process-insights-pendentes` (BrasilAPI em lote pelo admin):
# após alterar supabase/functions/process-insights-pendentes/, faça deploy com
#   npm run insights:deploy-process-worker
# (requer Supabase CLI autenticado). Sem deploy, o botão no admin mostra erro ao invocar.

# Edge Functions de e-mail transacional (Resend — template Always On):
#   npm run auth:deploy-email-fns
#   — admin-invite-user (convites)
#   — auth-recuperar-senha (esqueci senha)
#
# Secrets no dashboard (Edge Functions → Secrets) — obrigatórios:
#   RESEND_API_KEY       convite + recovery; sem ela, nenhum e-mail transacional sai
#   RESEND_FROM          remetente verificado, ex.: "AlwaysOn <nao-responda@arrudahub.dev>"
#   APP_PUBLIC_URL       URL canónica de produção nos links (ex.: alwayson-distribuidores.vercel.app)
#   ALLOWED_APP_ORIGINS  CSV opcional — além de localhost + vercel.app

# Aplicação de migrations SQL via scripts/apply-migrations.mjs.
# Pegue em: Supabase dashboard → Project Settings → Database → Connection string → URI (Session pooler).
# DATABASE_URL=postgresql://postgres.osukbalwykbqvoumddxz:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
